---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja" class="bg-neutral-950 text-neutral-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    <link rel="icon" href="/favicon.ico" />

    <!-- 全画面SPA化＆高速先読みエンジン -->
    <ClientRouter />
  </head>
  <body class="min-h-dvh flex flex-col relative overflow-x-hidden">
    
    <!-- 全画面共通ローダー（ページ間をまたいで維持） -->
    <div
      id="page-loader"
      transition:persist
      class="fixed inset-0 z-50 flex items-center justify-center bg-neutral-950 pointer-events-none opacity-0 transition-opacity duration-200"
    >
      <div id="loader-spinner" class="cube-grid-loader">
        <div class="cube cube-fill"></div>
        <div class="cube cube-bright"></div>
        <div class="cube cube-dim"></div>
      </div>
    </div>

    <slot />

    <script>
      function showLoader() {
        const loader = document.getElementById('page-loader');
        if (loader) {
          loader.classList.remove('opacity-0', 'pointer-events-none');
          loader.classList.add('opacity-100', 'pointer-events-auto');
        }
      }

      function hideLoader() {
        const loader = document.getElementById('page-loader');
        if (loader) {
          loader.classList.remove('opacity-100', 'pointer-events-auto');
          loader.classList.add('opacity-0', 'pointer-events-none');
        }
      }

      // 1. ページ遷移（通信・準備）開始時
      document.addEventListener('astro:before-preparation', () => {
        showLoader();
      });

      // 2. ページ描画完了時（即座にローダー解除）
      document.addEventListener('astro:page-load', () => {
        hideLoader();
      });

      // 3. ブラウザバック (bfcache) 復元時
      window.addEventListener('pageshow', () => {
        hideLoader();
      });
    </script>
  </body>
</html>

<style is:global>
  /* 2x2マスの巡回ローダー */
  .cube-grid-loader {
    position: relative;
    width: 44px;
    height: 44px;
  }

  .cube {
    position: absolute;
    width: 18px;
    height: 18px;
    box-sizing: border-box;
    animation: cube-loop 1.4s infinite ease-in-out;
  }

  .cube-fill {
    background-color: #507572;
    animation-delay: 0s;
  }

  .cube-bright {
    border: 2px solid #d4e0e0;
    animation-delay: -0.35s;
  }

  .cube-dim {
    border: 2px solid #233e3d;
    animation-delay: -0.7s;
  }

  @keyframes cube-loop {
    0%, 100% {
      top: 0;
      left: 0;
    }
    25% {
      top: 0;
      left: 24px;
    }
    50% {
      top: 24px;
      left: 24px;
    }
    75% {
      top: 24px;
      left: 0;
    }
  }
</style>