---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import TimetableTimeline from '../../components/TimetableTimeline.astro';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => {
    const pathSlug = event.data.customSlug || event.id.replace(/\.[^/.]+$/, '');
    return {
      params: { slug: pathSlug },
      props: { event },
    };
  });
}

const { event } = Astro.props;
const {
  title,
  date,
  time,
  place,
  organizers,
  group,
  performers,
  announcements,
  hashtags,
  flyer,
  timetableImage,
  timeSlots,
  mixArchives,
  setlist,
  gallery,
} = event.data;

const formatJapaneseDate = (dateStr: string) => {
  const parts = dateStr.split('-').map(Number);
  if (parts.length === 3 && !parts.some(isNaN)) {
    return `${parts[0]}年${parts[1]}月${parts[2]}日`;
  }
  return dateStr;
};

const getYouTubeEmbedUrl = (urlStr: string) => {
  try {
    const parsed = new URL(urlStr);
    let videoId = '';
    if (parsed.hostname.includes('youtu.be')) {
      videoId = parsed.pathname.slice(1);
    } else if (parsed.hostname.includes('youtube.com')) {
      if (parsed.pathname.startsWith('/embed/')) {
        videoId = parsed.pathname.replace('/embed/', '');
      } else if (parsed.pathname.startsWith('/live/')) {
        videoId = parsed.pathname.replace('/live/', '');
      } else {
        videoId = parsed.searchParams.get('v') || '';
      }
    }
    return videoId ? `https://www.youtube-nocookie.com/embed/${videoId}` : null;
  } catch {
    return null;
  }
};

const linkStyle = "underline underline-offset-4 decoration-neutral-700 hover:text-miku hover:decoration-miku transition-colors duration-200";

const groupedPerformers = performers?.reduce((acc, p) => {
  const roleName = p.role || 'Performer';
  if (!acc[roleName]) {
    acc[roleName] = [];
  }
  acc[roleName].push(p);
  return acc;
}, {} as Record<string, typeof performers>);

if (groupedPerformers) {
  for (const role in groupedPerformers) {
    groupedPerformers[role]?.sort((a, b) =>
      a.name.localeCompare(b.name, 'ja', { sensitivity: 'base', numeric: true })
    );
  }
}

const hasAnnounceOrHashtag = (announcements && announcements.length > 0) || (hashtags && hashtags.length > 0);
---

<Layout title={title}>
  <main class="max-w-5xl mx-auto px-4 py-8 sm:py-12 font-mono flex flex-col gap-8 sm:gap-10 text-xs">
    
    <!-- ヘッダー -->
    <header class="border-b border-neutral-900 pb-6 flex flex-col gap-3">
      <h1 class="text-xl sm:text-3xl font-bold text-white tracking-tight">{title}</h1>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-neutral-400">
        <span>{formatJapaneseDate(date)}</span>
        {time && <span>{time.start}{time.end ? `-${time.end}` : ''}</span>}
        {place && (
          <span class="flex items-center gap-1.5">
            {place.url ? (
              <a href={place.url} target="_blank" rel="noreferrer noopener" class={linkStyle}>
                {place.name}
              </a>
            ) : (
              <span>{place.name}</span>
            )}
            {place.isVr && place.instance && (
              <span class="text-neutral-500">[{place.instance}]</span>
            )}
          </span>
        )}
      </div>
    </header>

    <!-- 上段：フライヤー / Information -->
    <div class="grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-6 sm:gap-8 items-start">
      {flyer && (
        <div class="w-full flex justify-center">
          <div class="w-full max-w-md lg:max-w-none rounded-xl overflow-hidden border border-neutral-800 bg-neutral-950 shadow-2xl">
            <Image
              src={flyer}
              alt={title}
              width={1000}
              loading="eager"
              class="w-full h-auto max-h-[50vh] sm:max-h-[60vh] lg:max-h-none object-contain block mx-auto"
            />
          </div>
        </div>
      )}

      <section class="p-5 sm:p-6 rounded-xl border border-neutral-800/60 bg-neutral-900/20 flex flex-col gap-4">
        <h2 class="text-xs font-bold text-miku uppercase tracking-widest border-b border-neutral-800/60 pb-2">Information</h2>

        <div class="flex flex-col gap-3 leading-relaxed text-neutral-400">
          {(organizers || group) && (
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
              <span class="text-neutral-500 shrink-0">Organizer:</span>
              <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
                {organizers?.map((org, i) => (
                  <span>
                    {org.url ? (
                      <a href={org.url} target="_blank" rel="noreferrer noopener" class={linkStyle}>{org.name}</a>
                    ) : (
                      <span>{org.name}</span>
                    )}
                    {i < organizers.length - 1 && <span class="text-neutral-600">,</span>}
                  </span>
                ))}
                {group && (
                  <span class="text-neutral-500">
                    (Group: {group.url ? <a href={group.url} target="_blank" rel="noreferrer noopener" class={linkStyle}>{group.name}</a> : group.name})
                  </span>
                )}
              </div>
            </div>
          )}

          {groupedPerformers && Object.keys(groupedPerformers).length > 0 && (
            <div class="flex flex-col gap-2.5 pt-2 border-t border-neutral-800/40">
              {Object.entries(groupedPerformers).map(([roleName, list]) => (
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-2">
                  <span class="text-neutral-500 shrink-0 min-w-[2.5rem]">{roleName}:</span>
                  <div class="flex flex-wrap gap-x-1.5 gap-y-1">
                    {list.map((p, i) => (
                      <span>
                        {p.url ? (
                          <a href={p.url} target="_blank" rel="noreferrer noopener" class={linkStyle}>{p.name}</a>
                        ) : (
                          <span>{p.name}</span>
                        )}
                        {i < list.length - 1 && <span class="text-neutral-600">,</span>}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}

          {hasAnnounceOrHashtag && (
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 pt-2 border-t border-neutral-800/40 text-neutral-400">
              {announcements?.map((a, i) => (
                <>
                  <a href={a.url} target="_blank" rel="noreferrer noopener" class={linkStyle}>
                    {a.name}
                  </a>
                  {(i < announcements.length - 1 || (hashtags && hashtags.length > 0)) && (
                    <span class="text-neutral-700 select-none">/</span>
                  )}
                </>
              ))}

              {hashtags?.map((tag, i) => (
                <>
                  <span class="text-neutral-500">{tag}</span>
                  {i < hashtags.length - 1 && (
                    <span class="text-neutral-700 select-none">/</span>
                  )}
                </>
              ))}
            </div>
          )}
        </div>
      </section>
    </div>

    <!-- 下段セクション群 -->

    <!-- 1. タイムテーブル -->
    {(timetableImage || (timeSlots && timeSlots.length > 0)) && (
      <section class="flex flex-col items-center gap-6 border-t border-neutral-900 pt-8 w-full">
        {timetableImage && (
          <div class="w-full flex justify-center">
            <Image
              src={timetableImage}
              alt="Timetable"
              width={1000}
              class="w-full h-auto max-w-md sm:max-w-lg lg:max-w-[540px] max-h-[60vh] lg:max-h-none object-contain block mx-auto rounded-xl shadow-2xl"
            />
          </div>
        )}

        {timeSlots && timeSlots.length > 0 && (
          <TimetableTimeline data={timeSlots} eventTime={time} />
        )}
      </section>
    )}

    <!-- 2. 音源・動画アーカイブ -->
    {mixArchives && mixArchives.length > 0 && (
      <section class="flex flex-col gap-4 border-t border-neutral-900 pt-8">
        <h2 class="text-xs font-bold text-neutral-400 uppercase tracking-widest">Mix Archive</h2>
        <div class="flex flex-col gap-4">
          {mixArchives.map((archive) => {
            const ytEmbedUrl = archive.platform === 'youtube' ? getYouTubeEmbedUrl(archive.url) : null;

            return (
              <div class="p-4 rounded-xl border border-neutral-800 bg-neutral-900/30 flex flex-col gap-3">
                {archive.title && <span class="text-white font-bold">{archive.title}</span>}
                
                {archive.platform === 'cloudflare' && (
                  <audio controls class="w-full h-8" src={archive.url}></audio>
                )}

                {archive.platform === 'mixcloud' && (
                  <div class="w-full rounded-lg overflow-hidden border border-neutral-800 bg-neutral-950">
                    <iframe
                      width="100%"
                      height="60"
                      src={`https://www.mixcloud.com/widget/iframe/?hide_cover=1&mini=1&light=0&feed=${encodeURIComponent(archive.url)}`}
                      frameborder="0"
                      class="block"
                      allow="autoplay"
                    ></iframe>
                  </div>
                )}

                {archive.platform === 'youtube' && (
                  ytEmbedUrl ? (
                    <div class="w-full aspect-video rounded-xl overflow-hidden border border-neutral-800 bg-neutral-950">
                      <iframe
                        src={ytEmbedUrl}
                        title={archive.title || 'YouTube Player'}
                        class="w-full h-full block"
                        frameborder="0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                      ></iframe>
                    </div>
                  ) : (
                    <div>
                      <a href={archive.url} target="_blank" rel="noreferrer noopener" class={linkStyle}>
                        Watch on YouTube
                      </a>
                    </div>
                  )
                )}
              </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- 3. セットリスト -->
    {setlist && setlist.length > 0 && (
      <section class="flex flex-col gap-4 border-t border-neutral-900 pt-8">
        <h2 class="text-xs font-bold text-neutral-400 uppercase tracking-widest">Setlist</h2>
        <div class="border border-neutral-800 rounded-xl overflow-x-auto bg-neutral-950/40">
          <table class="w-full text-left border-collapse min-w-[320px]">
            <thead>
              <tr class="bg-neutral-900/80 border-b border-neutral-800 text-neutral-400">
                <th class="py-2.5 px-3 w-10 text-center">#</th>
                <th class="py-2.5 px-3">Artist</th>
                <th class="py-2.5 px-3">Track</th>
                <th class="py-2.5 px-3 w-16 text-center">Link</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-900 text-neutral-400">
              {setlist.map((item, idx) => (
                <tr class="hover:bg-neutral-900/30 transition">
                  <td class="py-2 px-3 text-center text-neutral-500 tabular-nums">{idx + 1}</td>
                  <td class="py-2 px-3">{item.artist}</td>
                  <td class="py-2 px-3 font-bold text-neutral-200">{item.track}</td>
                  <td class="py-2 px-3 text-center">
                    {item.url && (
                      <a href={item.url} target="_blank" rel="noreferrer noopener" class={linkStyle}>
                        Link
                      </a>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <!-- 4. SNSギャラリー -->
    {gallery && gallery.length > 0 && (
      <section class="flex flex-col items-center gap-6 border-t border-neutral-900 pt-8 w-full" id="gallery-container">
        <h2 class="text-xs font-bold text-neutral-400 uppercase tracking-widest text-center">Gallery</h2>
        <div class="flex flex-wrap justify-center gap-4 w-full">
          {gallery.map((link) => {
            const isTwitter = /twitter\.com|x\.com/.test(link);
            const isBluesky = /bsky\.app/.test(link);

            return isTwitter ? (
              <div class="w-full max-w-[300px] min-h-[280px] flex justify-center shrink-0">
                <blockquote class="twitter-tweet" data-theme="dark" data-dnt="true">
                  <a href={link}></a>
                </blockquote>
              </div>
            ) : isBluesky ? (
              <div class="w-full max-w-[300px] min-h-[280px] flex justify-center shrink-0">
                <blockquote class="bluesky-embed" data-bluesky-uri={link} data-bluesky-theme="dark">
                  <a href={link}></a>
                </blockquote>
              </div>
            ) : (
              <a
                href={link}
                target="_blank"
                rel="noreferrer noopener"
                class={`px-3 py-1.5 rounded-lg border border-neutral-800 bg-neutral-900/40 text-neutral-400 hover:border-neutral-700 ${linkStyle}`}
              >
                Link &rarr;
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- フッター -->
    <footer class="w-full flex flex-col sm:flex-row justify-between items-center sm:items-end gap-4 pt-16 border-t border-neutral-900 mt-16">
      <span class="font-mono text-[10px] text-neutral-600 tracking-widest order-2 sm:order-1">
        &copy; {new Date().getFullYear()} loser4dim
      </span>

      <a
        href="/profile"
        class={`text-xs font-mono text-neutral-500 tracking-wider order-1 sm:order-2 ${linkStyle}`}
        aria-label="Back to Profile"
      >
        Profile
      </a>
    </footer>

  </main>
</Layout>

<!-- ★SPA遷移（View Transitions）対応の埋め込みスクリプト -->
<script is:inline>
  const initSocialWidgets = () => {
    // 1. Twitter / X の再スキャン & 読み込み
    if (window.twttr && window.twttr.widgets) {
      window.twttr.widgets.load();
    } else if (!document.getElementById('twitter-wjs')) {
      const script = document.createElement('script');
      script.id = 'twitter-wjs';
      script.src = 'https://platform.twitter.com/widgets.js';
      script.async = true;
      document.body.appendChild(script);
    }

    // 2. Bluesky の再読み込み
    const existingBsky = document.getElementById('bsky-embed-script');
    if (existingBsky) {
      existingBsky.remove();
    }
    const bskyScript = document.createElement('script');
    bskyScript.id = 'bsky-embed-script';
    bskyScript.src = 'https://embed.bsky.app/static/embed.js';
    bskyScript.async = true;
    document.body.appendChild(bskyScript);
  };

  // 通常読み込み & AstroのSPA画面遷移完了時に実行
  document.addEventListener('astro:page-load', initSocialWidgets);
</script>